    .table-responsive {
        border-radius: 8px !important;
    }

    .dash-table th,
    .dash-table td {
        padding: 7px 8px !important;
        font-size: 11px !important;
    }
}

/* --- SMARTPHONE KECIL (<= 480px) --- */
@media (max-width: 480px) {
    .header h1 {
        font-size: 20px !important;
    }
    .header p {
        font-size: 11.5px !important;
    }
    .hero-main-title {
        font-size: 22px !important;
    }
    .step h2 {
        font-size: 14px !important;
    }
    .step p {
        font-size: 11.5px !important;
    }
    .stats-grid {
        gap: 4px !important;
    }
    .stat-card {
        padding: 6px 4px !important;
    }
    .stat-card .stat-val {
        font-size: 14px !important;
    }
}

/* ==========================================================================
   CARA SURUH - Background Khas Polindra Suruh & Step Card Solid
   ========================================================================== */
body.page-cara-suruh {
    background: var(--primary-gradient);
}

body.page-cara-suruh .steps {
    position: relative;
    z-index: 2;
}

body.page-cara-suruh .step {
    background: #ffffff !important;
    box-shadow: 0 4px 18px rgba(0,0,0,0.08) !important;
}

body.page-cara-suruh .flow {
    position: relative;
    z-index: 2;
}

body.page-cara-suruh .header {
    position: relative;
    z-index: 2;
}

body.page-cara-suruh .bottom {
    position: relative;
    z-index: 2;
}

/* ==========================================================================
   FIX: ADMIN NAVBAR - Overflow hidden diganti visible + scroll horizontal
   ========================================================================== */
.admin-navbar {
    overflow: visible !important;
}

.admin-nav-menu {
    overflow-x: auto !important;
    flex-wrap: nowrap !important;
    padding-bottom: 2px !important;
    scrollbar-width: none !important;
}

.admin-nav-menu::-webkit-scrollbar {
    display: none !important;
}

@media (max-width: 768px) {
    .admin-navbar {
        overflow: visible !important;
        position: relative !important;
        z-index: 10 !important;
    }

    .admin-nav-menu {
        flex-wrap: nowrap !important;
        overflow-x: auto !important;
        width: 100% !important;
        gap: 4px !important;
        padding-bottom: 4px !important;
        -webkit-overflow-scrolling: touch !important;
    }

    .admin-nav-link {
        flex-shrink: 0 !important;
        white-space: nowrap !important;
    }

    .admin-btn-logout {
        flex-shrink: 0 !important;
        white-space: nowrap !important;
    }

    /* Alert banner tidak tertimpa navbar */
    .alert.alert-warning {
        position: relative !important;
        z-index: 1 !important;
        margin-top: 0 !important;
    }
}

@media (max-width: 480px) {
    .admin-navbar {
        gap: 6px !important;
    }

    .admin-nav-link {
        padding: 5px 9px !important;
        font-size: 11px !important;
    }

    .admin-btn-logout {
        padding: 5px 9px !important;
        font-size: 11px !important;
    }
}

/* ==========================================================================
   SANTO SURUH AUTH STYLE (Login & Register Redesign)
   ========================================================================== */
body.page-santo-auth {
    min-height: 100vh;
    margin: 0;
    padding: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255, 210, 31, 0.12) 0%, transparent 60%),
                radial-gradient(circle at 75% 50%, rgba(245, 158, 11, 0.08) 0%, transparent 50%),
                linear-gradient(135deg, #07090e 0%, #0d121d 50%, #030508 100%);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-x: hidden;
    overflow-y: auto;
    position: relative;
}

body.page-santo-auth::before,
body.page-santo-auth::after {
    display: none !important;
}

/* CONTAINER LAYOUT */
.santo-desktop-container {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 2;
}

/* DESKTOP MASCOT SHOWCASE (EFEK BERCAHAYA) */
.santo-desktop-mascot {
    display: none;
}

@media (min-width: 901px) {
    .santo-desktop-container {
        min-height: 100vh;
        padding: 40px 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 50px;
        max-width: 1020px;
        margin: 0 auto;
    }

    .santo-desktop-mascot {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        width: 360px;
        flex-shrink: 0;
        text-align: center;
    }

    /* GLOWING AURA DI BELAKANG MASKOT */
    .mascot-ambient-glow {
        position: absolute;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 210, 31, 0.6) 0%, rgba(245, 158, 11, 0.28) 45%, transparent 70%);
        filter: blur(40px);
        top: 25%;
        left: 50%;
        transform: translate(-50%, -25%);
        z-index: 1;
        pointer-events: none;
        animation: glowPulse 3.5s ease-in-out infinite alternate;
    }

    /* MASKOT ISOLATED DENGAN EFEK BERCAHAYA TEGAS */
    .mascot-isolated-img {
        width: 100%;
        max-width: 330px;
        height: auto;
        object-fit: contain;
        position: relative;
        z-index: 2;
        filter: drop-shadow(0 0 25px rgba(255, 210, 31, 0.85)) drop-shadow(0 0 55px rgba(245, 158, 11, 0.5));
        animation: mascotFloat 4s ease-in-out infinite alternate;
        user-select: none;
        pointer-events: none;
    }

    .mascot-tag-box {
        position: relative;
        z-index: 3;
        margin-top: 14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(15, 23, 42, 0.9);
        border: 1.5px solid rgba(255, 210, 31, 0.5);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 25px rgba(255, 210, 31, 0.25);
        padding: 8px 20px;
        border-radius: 30px;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.3px;
        backdrop-filter: blur(8px);
    }

    .mascot-tag-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 10px #10b981;
        display: inline-block;
    }
}

@keyframes mascotFloat {
    0% {
        transform: translateY(0px);
    }
    100% {
        transform: translateY(-10px);
    }
}

@keyframes glowPulse {
    0% {
        transform: translate(-50%, -25%) scale(0.92);
        opacity: 0.75;
    }
    100% {
        transform: translate(-50%, -25%) scale(1.15);
        opacity: 1;
    }
}

.santo-auth-wrapper {
    width: 100%;
    max-width: 440px;
    min-height: 100vh;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
    position: relative;
    overflow: hidden;
    z-index: 2;
}

@media (min-width: 601px) {
    .santo-auth-wrapper {
        min-height: auto;
        border-radius: 24px;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.65), 0 0 45px rgba(255, 210, 31, 0.15), 0 0 0 1px rgba(255, 255, 255, 0.12);
        border: none;
    }
}

@media (max-width: 600px) {
    body.page-santo-auth {
        background: #ffffff;
        padding: 0;
    }
    .santo-auth-wrapper {
        max-width: 100%;
        box-shadow: none;
        border-radius: 0;
    }
    .santo-hero-banner {
        height: 235px;
    }
    .santo-hero-mascot {
        max-width: 180px;
        max-height: 130px;
    }
    .santo-hero-tagline {
        font-size: 15.5px !important;
    }
    .santo-form-card {
        padding: 20px 18px 28px;
    }
}

/* TOP HERO BANNER (Maskot Motor Polindra Suruh + Efek Bercahaya) */
.santo-hero-banner {
    position: relative;
    width: 100%;
    height: 255px;
    background: radial-gradient(circle at 50% 38%, rgba(255, 210, 31, 0.28) 0%, rgba(15, 23, 42, 0.95) 75%),
                linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.santo-hero-glow-aura {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 210, 31, 0.85) 0%, rgba(245, 158, 11, 0.35) 45%, transparent 70%);
    filter: blur(28px);
    top: 15px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    pointer-events: none;
    animation: bannerGlowPulse 3s ease-in-out infinite alternate;
}

@keyframes bannerGlowPulse {
    0% {
        transform: translateX(-50%) scale(0.9);
        opacity: 0.8;
    }
    100% {
        transform: translateX(-50%) scale(1.15);
        opacity: 1;
    }
}

.santo-hero-overlay {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 18px 18px 22px;
    text-align: center;
    width: 100%;
}

.santo-hero-mascot-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    margin-bottom: 6px;
    width: 100%;
}

.santo-hero-mascot {
    width: 90%;
    max-width: 220px;
    max-height: 155px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 14px rgba(255, 210, 31, 0.9)) drop-shadow(0 0 28px rgba(245, 158, 11, 0.5));
    user-select: none;
    pointer-events: none;
    transition: transform 0.3s ease;
}

.santo-hero-tagline {
    font-size: 17px;
    font-weight: 800;
    color: #ffffff;
    margin: 4px 0 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
    letter-spacing: -0.2px;
}

/* WHITE FORM CARD */
.santo-form-card {
    background: #ffffff;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 28px 26px 36px;
    border-radius: 24px 24px 0 0;
    margin-top: -20px;
    position: relative;
    z-index: 2;
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.06);
}

.santo-form-header {
    text-align: center;
    margin-bottom: 22px;
}

.santo-form-header h2 {
    font-size: 24px;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 6px;
    letter-spacing: -0.4px;
}

.santo-form-header p {
    font-size: 13.5px;
    color: #64748b;
    margin: 0;
    font-weight: 500;
}

/* FORM ELEMENTS */
.santo-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.santo-input-group {
    width: 100%;
    position: relative;
}

.santo-input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

@media (max-width: 360px) {
    .santo-input-row {
        grid-template-columns: 1fr;
    }
}

.santo-input {
    width: 100%;
    padding: 13px 16px;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    background: #f8fafc;
    color: #0f172a;
    font-size: 14px;
    font-family: inherit;
    font-weight: 500;
    transition: all 0.2s ease;
    box-sizing: border-box;
    outline: none;
}

.santo-input::placeholder {
    color: #94a3b8;
    font-weight: 400;
}

.santo-input:focus {
    border-color: #ffd21f;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(255, 210, 31, 0.25);
}

.santo-forgot-wrap {
    display: flex;
    justify-content: flex-end;
    margin-top: -4px;
    margin-bottom: 2px;
}

.santo-forgot-link {
    font-size: 12.5px;
    color: #0284c7;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
}

.santo-forgot-link:hover {
    color: #0369a1;
    text-decoration: underline;
}

/* SUBMIT BUTTON */
.santo-btn-submit {
    width: 100%;
    padding: 14px 20px;
    border: none;
    border-radius: 10px;
    background: #ffd21f;
    color: #0f172a;
    font-size: 15px;
    font-weight: 800;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(255, 210, 31, 0.4);
    letter-spacing: 0.3px;
    margin-top: 6px;
    text-align: center;
    box-sizing: border-box;
}

.santo-btn-submit:hover {
    background: #f7b500;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(247, 181, 0, 0.45);
}

.santo-btn-submit:active {
    transform: translateY(0);
}

/* FOOTER & LINKS */
.santo-auth-footer {
    text-align: center;
    font-size: 13.5px;
    color: #64748b;
    margin-top: 22px;
    font-weight: 500;
}

.santo-auth-footer a {
    color: #0284c7;
    font-weight: 800;
    text-decoration: none;
    transition: color 0.15s ease;
}

.santo-auth-footer a:hover {
    color: #0369a1;
    text-decoration: underline;
}

.santo-back-home {
    text-align: center;
    margin-top: 14px;
}

.santo-back-home a {
    font-size: 12.5px;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
}

.santo-back-home a:hover {
    color: #475569;
}
